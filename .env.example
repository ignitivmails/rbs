# Copy to .env and adjust. .env is git-ignored.

# Database: SQLite file locally (created automatically).
# A postgres://… URL switches to Postgres for production (see DEPLOY.md).
DATABASE_URI=

# Media storage on S3 / Cloudflare R2 (production). Empty = local ./media folder.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Long random string used to sign admin sessions
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public URL of the site (used for live preview and metadata)
NEXT_PUBLIC_SERVER_URL=
# Razorpay — leave empty to use the built-in test-payment simulator locally.
# Get test keys (rzp_test_…) from https://dashboard.razorpay.com → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Razorpay dashboard → Webhooks) for /api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Google sign-in — leave empty to hide the Google button.
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email via Resend — leave empty to print emails in the terminal.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# SMS via MSG91 Flow API — leave empty to print SMS in the terminal.
# The DLT-approved template must contain one variable (default name: text).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_TEMPLATE_VAR=

# Shiprocket (pan-India shipping) — leave empty to generate test AWBs.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP=
